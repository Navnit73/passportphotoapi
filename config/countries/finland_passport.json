{
  "schema_version": "1.0",
  "country": {
    "name": "Finland",
    "code": "FI"
  },
  "document_type": "passport",
  "photo_spec": {
    "width_mm": 36,
    "height_mm": 47,
    "aspect_ratio": 0.766,
    "print_dpi": 300
  },
  "digital_requirements": {
    "required_resolution_px": {
      "width": 500,
      "height": 653
    },
    "min_resolution_px": {
      "width": 424,
      "height": 554
    },
    "max_resolution_px": {
      "width": 1211,
      "height": 1582
    },
    "max_file_size_kb": 250,
    "format": [
      "jpg",
      "jpeg"
    ],
    "background_color": "light-gray"
  },
  "face_constraints": {
    "head_height_pct": {
      "min": 68,
      "max": 77
    },
    "eye_position": {
      "from_bottom_pct": {
        "min": 50,
        "max": 65
      }
    },
    "top_margin_pct": {
      "min": 8,
      "recommended": 10
    },
    "chin_to_bottom_pct": {
      "min": 15
    }
  },
  "pose_rules": {
    "head_tilt_allowed": false,
    "expression": "neutral",
    "eyes_open": true,
    "mouth_closed": true,
    "both_ears_visible": false
  },
  "background_rules": {
    "color": "plain light gray",
    "shadows_allowed": false,
    "texture_allowed": false
  },
  "print_layout": {
    "paper_size": "A4",
    "photos_per_sheet": 8,
    "spacing_mm": 5,
    "cut_guides": true
  },
  "auto_crop_config": {
    "head_top_multiplier": 1.24,
    "eye_line_target_pct": 0.6,
    "safe_padding_pct": 5
  },
  "data_source": "official",
  "source_url": "https://poliisi.fi/en/submitting-passport-photographs",
  "source_authority": "Finnish Police (Poliisi) \u2013 National Passport Photo Instructions"
}