{
  "schema_version": "1.0",
  "country": {
    "name": "Canada",
    "code": "CA"
  },
  "document_type": "passport",
  "photo_spec": {
    "width_mm": 50,
    "height_mm": 70,
    "aspect_ratio": 0.714,
    "print_dpi": 300
  },
  "digital_requirements": {
    "required_resolution_px": {
      "width": 1200,
      "height": 1800
    },
    "min_resolution_px": {
      "width": 1200,
      "height": 1800
    },
    "max_resolution_px": {
      "width": 3000,
      "height": 4500
    },
    "max_file_size_kb": 4096,
    "format": [
      "jpg",
      "jpeg"
    ],
    "background_color": "plain white"
  },
  "face_constraints": {
    "head_height_pct": {
      "min": 45,
      "max": 51
    },
    "eye_position": {
      "from_bottom_pct": {
        "min": 45,
        "max": 60
      }
    },
    "top_margin_pct": {
      "min": 5,
      "recommended": 8
    },
    "chin_to_bottom_pct": {
      "min": 5
    }
  },
  "pose_rules": {
    "head_tilt_allowed": false,
    "expression": "neutral",
    "eyes_open": true,
    "mouth_closed": true,
    "both_ears_visible": false
  },
  "background_rules": {
    "color": "plain white",
    "shadows_allowed": false,
    "texture_allowed": false
  },
  "print_layout": {
    "paper_size": "A4",
    "photos_per_sheet": 6,
    "spacing_mm": 5,
    "cut_guides": true
  },
  "auto_crop_config": {
    "head_top_multiplier": 1.24,
    "eye_line_target_pct": 0.6,
    "safe_padding_pct": 5
  },
  "data_source": "official",
  "source_url": "https://www.canada.ca/en/immigration-refugees-citizenship/services/canadian-passports/photos.html",
  "source_authority": "Government of Canada"
}