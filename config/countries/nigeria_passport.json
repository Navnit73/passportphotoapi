{
  "schema_version": "1.0",
  "country": {
    "name": "Nigeria",
    "code": "NG"
  },
  "document_type": "passport",
  "photo_spec": {
    "width_mm": 35,
    "height_mm": 45,
    "aspect_ratio": 0.778,
    "print_dpi": 400
  },
  "digital_requirements": {
    "required_resolution_px": {
      "width": 600,
      "height": 800
    },
    "min_resolution_px": {
     "width": 600,
      "height": 800
    },
    "max_resolution_px": {
      "width": 600,
      "height": 800
    },
    "max_file_size_kb": 2048,
    "format": [
      "jpg",
      "jpeg"
    ],
    "background_color": "white"
  },
  "face_constraints": {
    "head_height_pct": {
      "min": 70,
      "max": 80
    },
    "eye_position": {
      "from_bottom_pct": {
        "min": 50,
        "max": 65
      }
    },
    "top_margin_pct": {
      "min": 5,
      "recommended": 8
    },
    "chin_to_bottom_pct": {
      "min": 5
    }
  },
  "pose_rules": {
    "head_tilt_allowed": false,
    "expression": "neutral",
    "eyes_open": true,
    "mouth_closed": true,
    "both_ears_visible": true
  },
  "background_rules": {
    "color": "plain white",
    "shadows_allowed": false,
    "texture_allowed": false
  },
  "print_layout": {
    "paper_size": "A4",
    "photos_per_sheet": 8,
    "spacing_mm": 5,
    "cut_guides": true
  },
  "auto_crop_config": {
    "head_top_multiplier": 1.24,
    "eye_line_target_pct": 0.6,
    "safe_padding_pct": 5
  },
  "data_source": "official",
  "source_url": "https://passport.immigration.gov.ng/",
  "source_authority": "Nigeria Immigration Service (NIS) / ICAO Doc 9303"
}
