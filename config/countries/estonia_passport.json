{
  "schema_version": "1.0",
  "country": {
    "name": "Estonia",
    "code": "EE"
  },
  "document_type": "passport",
  "photo_spec": {
    "width_mm": 40,
    "height_mm": 50,
    "aspect_ratio": 0.8,
    "print_dpi": 300
  },
  "digital_requirements": {
    "required_resolution_px": {
      "width": 1300,
      "height": 1600
    },
    "min_resolution_px": {
      "width": 400,
      "height": 500
    },
    "max_resolution_px": {
      "width": 1000,
      "height": 1300
    },
    "max_file_size_kb": 2024,
    "format": [
      "jpg",
      "jpeg"
    ],
    "background_color": "light-gray"
  },
  "face_constraints": {
    "head_height_pct": {
      "min": 70,
      "max": 80
    },
    "eye_position": {
      "from_bottom_pct": {
        "min": 50,
        "max": 65
      }
    },
    "top_margin_pct": {
      "min": 5,
      "recommended": 8
    },
    "chin_to_bottom_pct": {
      "min": 5
    }
  },
  "pose_rules": {
    "head_tilt_allowed": false,
    "expression": "neutral",
    "eyes_open": true,
    "mouth_closed": true,
    "both_ears_visible": true
  },
  "background_rules": {
    "color": "plain light gray",
    "shadows_allowed": false,
    "texture_allowed": false
  },
  "print_layout": {
    "paper_size": "A4",
    "photos_per_sheet": 8,
    "spacing_mm": 5,
    "cut_guides": true
  },
  "auto_crop_config": {
    "head_top_multiplier": 1.24,
    "eye_line_target_pct": 0.6,
    "safe_padding_pct": 5
  },
  "data_source": "official",
  "source_url": "https://www.schengenvisainfo.com/photo-requirements/",
  "source_authority": "Schengen Visa Information – ICAO Standard"
}